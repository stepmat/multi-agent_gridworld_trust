    def update_trust(self, other_agent_id, interaction_success, location):
        # risk-aware
        if agents[other_agent_id].noise_level == 0:
            interaction_success = True

        if not (apply_trust_threshold and self.trust_values[other_agent_id] < self.min_trust_level):
            if other_agent_id not in self.true_interaction:
                self.true_interaction[other_agent_id] = 0
                self.false_interaction[other_agent_id] = 0

            updated_trust = 0
            previous_trust = self.trust_values[other_agent_id]

            if trust_update == 0:
                if interaction_success:
                    self.true_interaction[other_agent_id] = self.true_interaction[other_agent_id] + 1
                    interaction_result = 1
                else:
                    self.false_interaction[other_agent_id] = self.false_interaction[other_agent_id] + 1
                    interaction_result = 0

                    # risk-aware
                    self.incorrect_decsion_impact += abs(self.current_location[0] - location[0]) + abs(
                        self.current_location[1] - location[1])
                    # risk-aware

                if other_agent_id in self.trust_values:
                    # privouse trust
                    previous_trust = self.direct_trust[other_agent_id]

                    #Paper: A Multi-Robot-Based Architecture and a Trust Model for Intelligent Fault Management and Control Systems
                    # Equation (2)
                    # Only direct trust
                    self.direct_trust[other_agent_id] = alpha1 * previous_trust + (1 - alpha1) * (
                            self.true_interaction[other_agent_id] / (
                            self.true_interaction[other_agent_id] + self.false_interaction[other_agent_id]))

                    updated_trust = self.direct_trust[other_agent_id]

                    if use_indirect:
                        direct_trust = self.direct_trust[other_agent_id]

                        # Calculate Indirect trust
                        indirect_trust = 0.0
                        total_weight = 0.0

                        # Paper: A Multi-Robot-Based Architecture and a Trust Model for Intelligent Fault Management and Control Systems
                        # Equation (3)
                        for intermediary_agent, intermediary_trust in self.trust_values.items():
                            if intermediary_agent != other_agent_id:
                                indirect_trust += (
                                        intermediary_trust * agents[intermediary_agent].trust_values[other_agent_id]
                                )
                                total_weight += intermediary_trust
                        indirect_trust = indirect_trust / total_weight

                        # direct and indirect trust
                        # Paper: A Multi-Robot-Based Architecture and a Trust Model for Intelligent Fault Management and Control Systems
                        # Equation (4)
                        updated_trust = alpha2 * direct_trust + (1 - alpha2) * indirect_trust
                        self.trust_values[other_agent_id] = updated_trust

            if trust_update == 1 or trust_update == 2:
                if interaction_success:
                    self.true_interaction[other_agent_id] = self.true_interaction[other_agent_id] + 1
                    interaction_result = 1
                else:
                    self.false_interaction[other_agent_id] = self.false_interaction[other_agent_id] + 1
                    interaction_result = 0

                    # risk-aware
                    self.incorrect_decsion_impact += abs(self.current_location[0] - location[0]) + abs(
                        self.current_location[1] - location[1])
                    # risk-aware

                if other_agent_id in self.trust_values:
                    # Paper: Trust-based decision-making framework for multiagent system. Equation (5)
                    self.direct_trust[other_agent_id] = (self.true_interaction[other_agent_id] + 1) / (
                            self.true_interaction[other_agent_id] + self.false_interaction[other_agent_id] + 2)

                    updated_trust = self.direct_trust[other_agent_id]

                    if use_indirect:
                        direct_trust = self.direct_trust[other_agent_id]

                        # Calculate Indirect trust
                        indirect_trust = 0.0
                        total_weight = 0.0

                        for intermediary_agent, intermediary_trust in self.direct_trust.items():
                            if intermediary_agent != other_agent_id and intermediary_agent != self.agent_id:
                                # Paper: Trust-based decision-making framework for multiagent system. Equation (5)
                                indirect_trust += (
                                        (agents[intermediary_agent].direct_trust[other_agent_id] - self.direct_trust[other_agent_id]) * intermediary_trust
                                )
                                if trust_update == 1:
                                    # Paper: Trust-based decision-making framework for multiagent system. Equation (10)
                                    total_weight += 1
                                else:
                                    # Paper: Trust-based decision-making framework for multiagent system. Equation (11)
                                    total_weight += intermediary_trust

                        indirect_trust = indirect_trust / total_weight

                        # direct and indirect trust
                        # Paper: Trust-based decision-making framework for multiagent system. Equation (12)
                        self.trust_values[other_agent_id] = self.trust_values[other_agent_id] + alpha2 * (self.direct_trust[other_agent_id] + indirect_trust - self.trust_values[other_agent_id])
                        updated_trust = self.trust_values[other_agent_id]

            if trust_update == 3:
                if interaction_success:
                    self.true_interaction[other_agent_id] = self.true_interaction[other_agent_id] + 1
                    interaction_result = 1
                else:
                    self.false_interaction[other_agent_id] = self.false_interaction[other_agent_id] + 1
                    interaction_result = 0
                if other_agent_id not in self.interaction:
                    self.interaction[other_agent_id] = 0
                self.interaction[other_agent_id] = self.interaction[other_agent_id] + 1


                # risk-aware
                self.incorrect_decsion_impact += abs(self.current_location[0] - location[0]) + abs(
                    self.current_location[1] - location[1])
                # risk-aware

                if other_agent_id in self.trust_values:
                    if other_agent_id not in self.direct_trust:
                        self.direct_trust[other_agent_id] = 0

                    # Paper: Trust Networks in Multi-Robot Communities (5)
                    if interaction_success:
                        self.direct_trust[other_agent_id] = (1 + self.interaction[other_agent_id] * self.direct_trust[other_agent_id]) / (1 + self.interaction[other_agent_id])
                    else:
                        self.direct_trust[other_agent_id] = (self.interaction[other_agent_id] *
                                                             self.direct_trust[other_agent_id]) / (
                                                                        1 + self.interaction[other_agent_id])

                    updated_trust = self.direct_trust[other_agent_id]

                    if use_indirect:
                        direct_trust = self.direct_trust[other_agent_id]

                        # Calculate Indirect trust
                        indirect_trust = 0.0
                        total_weight = 0.0

                        for intermediary_agent, intermediary_trust in self.trust_values.items():
                            if intermediary_agent != other_agent_id and intermediary_agent != self.agent_id:
                                indirect_trust += agents[intermediary_agent].trust_values[other_agent_id]
                                total_weight += 1

                        indirect_trust = indirect_trust / total_weight

                        # direct and indirect trust
                        # Paper: Trust Networks in Multi-Robot Communities (1)
                        self.trust_values[other_agent_id] = indirect_trust + alpha2 * (
                                    self.direct_trust[other_agent_id] - indirect_trust)
                        updated_trust = self.trust_values[other_agent_id]

            if trust_update == 4:
                if interaction_success:
                    sp = ServiceProvider(other_agent_id, p_success=1)
                    interaction_result = 1
                else:
                    sp = ServiceProvider(other_agent_id, p_success=0)
                    interaction_result = 0

                # Assign testimony regarding agents
                for wit in self.consumer.witnesses:
                    self.consumer.witnesses[wit].trust_values = agents[int(wit)].trust_values

                result = self.consumer.decide_and_interact(sp)
                self.incorrect_decsion_impact += abs(self.current_location[0] - location[0]) + abs(
                    self.current_location[1] - location[1])
                # risk-aware

                self.direct_trust[other_agent_id] = result["tau_d"]

                self.trust_values[other_agent_id] = result["reputation"]

                updated_trust = result["reputation"]

                # Update agent honesty
                self.consumer.witnesses[str(other_agent_id)].honesty = result["reputation"]

            # Set the trust value to be between 0 and 1
            self.trust_values[other_agent_id] = max(0.0, min(1.0, updated_trust))

            trust_type = "Direct + Indirect" if use_indirect else "Direct"

            print(
                f"Agent {self.agent_id} update trust for {other_agent_id}: :The previous trust value is: {previous_trust} : Updated trust: {updated_trust}  The interaction_result is {interaction_result}")

