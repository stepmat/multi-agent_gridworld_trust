    def get_direct_id(self, direction):
        if direction == 'U':
            return np.int64(1)
        if direction == 'D':
            return np.int64(2)
        if direction == 'L':
            return np.int64(3)
        if direction == 'R':
            return np.int64(4)
        return np.int64(0)

    def select_action(self, coordinate_observation, agent_id):
        # SAR
        if len(self.path) > 0:
            direction = self.get_direct_id(self.path[0])
            self.path.pop(0)
            return direction
        else:
            # Arrange target
            if len([tuple(taget["location"]) for taget in self.targets_seen if taget["verified"] == False]) > 1:
                if self.targets_seen_count != len(self.targets_seen):
                    if search_for_best_rewards:
                        tcga = TargetCollectionGA([tuple(taget["location"]) for taget in self.targets_seen if taget["verified"] == False], tuple(self.current_location))
                        tcga_result = tcga.run()
                        best_order = tcga_result['best_order']
                        self.targets_seen = [self.targets_seen[i] for i in best_order]
                        self.targets_seen_count = len(self.targets_seen)

            print(f"Agent {agent_id}: Current targets seen: {self.targets_seen}")

            self.targets_seen = list({tuple(target["location"]): target for target in self.targets_seen}.values())

            if len(self.targets_seen) > 0:
                closest_target = None
                closest_target_distance = float('inf')
                for target in self.targets_seen:
                    target_coordinate = target["location"]
                    horizontal_distance = target_coordinate[0] - coordinate_observation[0]
                    vertical_distance = target_coordinate[1] - coordinate_observation[1]
                    distance = abs(horizontal_distance) + abs(vertical_distance)
                    print(f"Agent {agent_id}: Target {target_coordinate} at distance {distance}")

                    if distance < closest_target_distance:
                        closest_target_distance = distance
                        closest_target = target_coordinate

                if closest_target:
                    # Check the validity of the target
                    grid_width = gsize
                    grid_height = gsize
                    if not (0 <= closest_target[0] < grid_width and 0 <= closest_target[1] < grid_height):
                        print(f"Invalid target location {closest_target}, skipping target.")
                        closest_target = None

                    if closest_target and closest_target_distance == 0:
                        print(f"Agent {agent_id}: Reached target at {closest_target}, removing from targets_seen.")
                        self.targets_seen = [t for t in self.targets_seen if tuple(t["location"]) != tuple(closest_target)]
                        return 0

                    if closest_target:
                        print(f"Agent {agent_id}: Moving towards target at {closest_target}")
                        horizontal_distance = closest_target[0] - coordinate_observation[0]
                        vertical_distance = closest_target[1] - coordinate_observation[1]
                        if abs(horizontal_distance) >= abs(vertical_distance):
                            return 3 if horizontal_distance < 0 else 4
                        else:
                            return 1 if vertical_distance < 0 else 2
                return 0
            else:
                # If action is going to be random, select another areas to cover.
                if search_algorithm == 44:
                    # move to nearest agent start location
                    best_agent_id = -1
                    shortest_distance = 2 * gsize + 1
                    for agent in agents:
                        if agent.agent_id not in self.visitend_agent_paths:
                            if len(self.get_manhattan_path_actions(self.current_location, agents[agent.agent_id].init_current_location)) < shortest_distance:
                                shortest_distance = len(self.get_manhattan_path_actions(self.current_location, agents[agent.agent_id].init_current_location))
                                best_agent_id = agent.agent_id

                    if best_agent_id > -1:
                        self.visitend_agent_paths.append(best_agent_id)
                        self.path = self.get_manhattan_path_actions(self.current_location, agents[best_agent_id].init_current_location) + self.all_path[best_agent_id].copy()
                        direction = self.get_direct_id(self.path[0])
                        self.path.pop(0)
                        return direction

                print(f"Agent {agent_id}: No valid targets, attempting random action.")
                possible_actions = [1, 2, 3, 4]
                return np.random.choice(possible_actions)

