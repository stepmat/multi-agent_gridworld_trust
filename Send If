    def generate_path_actions(self):
        path = self.path
        actions = []
        for i in range(1, len(path)):
            if path[i][0] - path[i - 1][0] == 1:
                actions.append('R')
            if path[i][0] - path[i - 1][0] == -1:
                actions.append('L')
            if path[i][1] - path[i - 1][1] == 1:
                actions.append('D')
            if path[i][1] - path[i - 1][1] == -1:
                actions.append('U')

        return actions

