                reward_normal=reward_normal, reward_obstacle=reward_obstacle, reward_target=reward_target
            )


            num_actions = len(env.action_space)

            agents = [SearchAgent(index, settings[index][0], settings[index][1], settings[index][2], num_actions) for
                      index in range(num_agents)]

            # create obstacle property
            env.obstacle_location = []
            for obstacle_position in env.obstacle_positions:
                env.obstacle_location.append((int(obstacle_position[0]/gpixels), int(obstacle_position[1]/gpixels)))

            # set start location
            for index, agent in enumerate(agents):
                agent.init_current_location = [int(env.agents[index]['coords'][0] / gpixels),int(env.agents[index]['coords'][1] / gpixels)]
                agent.current_location = agent.init_current_location
            for index, agent in enumerate(agents):
                agent.build_path()

            import pickle
            import os

            # File to store results
            file_path = "time_step_results.pkl"

            time_step_results = {}
            # Load from file if it exists, otherwise use default
            if os.path.exists(file_path):
                with open(file_path, "rb") as f:  # "rb" = read binary
                    time_step_results = pickle.load(f)

            # Run episodes
            run(num_episodes, max_steps_per_episode, agents, num_actions, env)

            if is_destroy_environment:
                env.destroy_environment()
