    # get action list to reach to taget
    def get_manhattan_path_actions(self, c1, c2, vertical_first=True):
        path = [c1]
        x1, y1 = c1
        x2, y2 = c2

        # Vertical then Horizontal
        if vertical_first:
            # Move vertically
            step = 1 if x2 > x1 else -1
            for x in range(x1 + step, x2 + step, step):
                path.append((x, y1))
            # Move horizontally
            step = 1 if y2 > y1 else -1
            for y in range(y1 + step, y2 + step, step):
                path.append((x2, y))
        else:
            # Horizontal then Vertical
            step = 1 if y2 > y1 else -1
            for y in range(y1 + step, y2 + step, step):
                path.append((x1, y))
            step = 1 if x2 > x1 else -1
            for x in range(x1 + step, x2 + step, step):
                path.append((x, y2))

        actions = []
        for i in range(1, len(path)):
            if path[i][0] - path[i - 1][0] == 1:
                actions.append('R')
            if path[i][0] - path[i - 1][0] == -1:
                actions.append('L')
            if path[i][1] - path[i - 1][1] == 1:
                actions.append('D')
            if path[i][1] - path[i - 1][1] == -1:
                actions.append('U')

        return actions

